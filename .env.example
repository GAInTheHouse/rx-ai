# ─────────────────────────────────────────────
# Rx-AI Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────

# Google Cloud — Vertex AI
# Path to the service account JSON key downloaded from GCP Console.
# IAM → Service Accounts → rx-ai-backend → Keys → Add Key → JSON
# Required roles: Vertex AI User, Cloud Speech-to-Text ServiceAgent, Cloud Text-to-Speech Editor
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/rx-ai-sa.json

# The GCP project ID (visible in Cloud Console header)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for Vertex AI endpoints (us-central1 has broadest model availability)
GOOGLE_CLOUD_LOCATION=us-central1

# ─────────────────────────────────────────────
# Gemini model identifiers
# ─────────────────────────────────────────────

# LLM used by CrewAI agents and /analyze-image
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud TTS voice name (Chirp3 HD = highest quality, clinical-neutral)
# Full list: https://cloud.google.com/text-to-speech/docs/voices
GEMINI_TTS_VOICE=en-US-Chirp3-HD-Aoede

# ─────────────────────────────────────────────
# Evaluation
# ─────────────────────────────────────────────

# Directory where JSONL evaluation logs are written (relative to project root)
EVAL_LOG_DIR=eval/logs

# BigQuery streaming sink (optional — leave blank to disable BQ streaming)
# Set BIGQUERY_DATASET to enable: eval_logger.py will stream every AI call to
# BigQuery table <BIGQUERY_DATASET>.<BIGQUERY_TABLE> in addition to JSONL.
# Required IAM role: BigQuery Data Editor on the dataset.
BIGQUERY_DATASET=rxai_eval
BIGQUERY_TABLE=feature_logs
